{
  "compilerOptions": {
    "paths": {
      "utils/*": [
        "./src/utils/*"
      ],
      "bootstrap/*": [
        "./src/bootstrap/*"
      ],
      "database/*": [
        "./src/database/*"
      ],
      "middleware/*": [
        "./src/middleware/*"
      ],
      "router/*": [
        "./src/router/*"
      ],
      "models/*": [
        "./src/models/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}