{
    "exclude": [
        ".*\\.d\\.ts$",
        ".*\\.map$"
    ],
    "jsc": {
        "parser": {
            "syntax": "ecmascript"
        },
        "experimental": {
            "plugins": [
                [
                    "swc-plugin-validate",
                    {}
                ],
                [
                    "swc-plugin-pre-paths",
                    {
                        "baseUrl": ".",
                        "paths": {
                            "utils/*": [
                                "./src/utils/*"
                            ],
                            "bootstrap/*": [
                                "./src/bootstrap/*"
                            ],
                            "database/*": [
                                "./src/database/*"
                            ],
                            "middleware/*": [
                                "./src/middleware/*"
                            ],
                            "router/*": [
                                "./src/router/*"
                            ],
                            "models/*": [
                                "./src/models/*"
                            ]
                        }
                    }
                ]
            ]
        },
        "target": "es2022"
    }
}