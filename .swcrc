{
    "exclude": [
        ".*\\.d\\.ts$",
        ".*\\.map$"
    ],
    "jsc": {
        "parser": {
            "syntax": "ecmascript"
        },
        "experimental": {
            "plugins": [
                [
                    "swc-plugin-validate",
                    {}
                ],
                [
                    "D:/project/swc-plugins/target/wasm32-wasip1/release/swc_plugin_path_resolver.wasm",
                    {
                        "alias": {
                            "@/": "./src/"
                        }
                    }
                ]
            ]
        },
        "target": "es2022"
    }
}