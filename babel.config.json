{
    "presets": [
        [
            "@babel/preset-env",
            {
                "corejs": "3.6.5"
            }
        ]
    ],
    "plugins": [
        "./babel-plugins/validate",
        [
            "module-resolver",
            {
                "root": [
                    "./src"
                ],
                "alias": {
                    "@": "./src"
                }
            }
        ]
    ]
}